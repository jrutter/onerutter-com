# Required for the /hello form. The page still renders when these are unset.
# A submit then shows a friendly error instead of sending.
# Set them in Vercel for Production and Preview. Locally, use .env.local (gitignored).

# API key from Resend. https://resend.com
RESEND_API_KEY=

# Inbox that receives the note. name@domain or Name <name@domain>
CONTACT_TO_EMAIL=

# Sender Resend will accept. Same shape as CONTACT_TO_EMAIL.
# The domain has to be verified in Resend.
CONTACT_FROM_EMAIL=

# Optional. Set to true to force draft notes and draft trips to render.
# `next dev` and Vercel preview deployments already show drafts.
# SHOW_DRAFTS=
